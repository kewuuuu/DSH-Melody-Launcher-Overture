{
  "name": "dsh-launcher",
  "version": "1.3.6",
  "private": true,
  "description": "A local desktop launcher and plugin organizer for DeepSeek Harness.",
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "launcher",
    "electron",
    "plugin",
    "modpack"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kewuuuu/DSH-Melody-Launcher-Overture.git"
  },
  "homepage": "https://github.com/kewuuuu/DSH-Melody-Launcher-Overture#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "bin": {
    "dsh-launcher-control": "bin/launcher-control.cjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "pack:official": "vite-node scripts/build-official-pack.mts",
    "fetch:runtimes": "vite-node scripts/fetch-node-runtime.mts",
    "uninstall:script": "vite-node scripts/build-uninstall-script.mts",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:win:setup": "electron-builder --win nsis",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.14",
    "adm-zip": "^0.6.0",
    "koffi": "^3.1.5",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.6",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.8.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^27.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-node": "^6.0.0",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.local.dshlauncher",
    "productName": "DSH-launcher-KEWU",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "bin/launcher-control.cjs",
      "tools/uninstall-kewu.ps1",
      "LICENSE",
      "NOTICE",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/@koromix/koffi-win32-x64/win32_x64",
        "to": "koffi/win32_x64"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "DSH-launcher-KEWU-Setup-${version}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "artifactName": "DSH-launcher-KEWU-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH-launcher-KEWU",
      "uninstallDisplayName": "DSH-launcher-KEWU",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true
    }
  }
}
